# ==============================================================================
# Pulse Keep-Alive & Uptime Monitoring Application - Environment Configuration
# ==============================================================================

# PostgreSQL Connection String for the Go worker
# Required for local execution and GitHub Actions Secrets (DATABASE_URL)
# Uses the dedicated, least-privilege pulse_worker role created in migrations/003_worker_role.sql
DATABASE_URL=postgresql://pulse_worker:YOUR_SECURE_WORKER_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Worker Configuration (Optional Defaults)
DEFAULT_TIMEOUT_SECONDS=90
CONCURRENCY=10

# Supabase Public Frontend Configuration (Used by Cloudflare Pages / Static Web)
# Configure these in web/js/config.js or via the in-dashboard setup prompt
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
