# ==============================================================================
# Pulse Keep-Alive & Uptime Monitoring Application - Environment Configuration
# ==============================================================================

# PostgreSQL Connection String for the Go worker
# Required for local execution and GitHub Actions Secrets (DATABASE_URL)
# NOTE: If connecting from an IPv4 network (or encountering "context deadline exceeded"),
# use Supabase's IPv4 connection pooler instead of direct db.<ref>.supabase.co:
#
# Dedicated pulse_worker role (Recommended):
#   postgresql://pulse_worker:YOUR_WORKER_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct Host (IPv6):
#   postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# IMPORTANT: If your password contains special characters like '@', URL-encode it (e.g., '@' -> '%40')!
DATABASE_URL=postgresql://pulse_worker:YOUR_WORKER_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Worker Configuration (Optional Defaults)
DEFAULT_TIMEOUT_SECONDS=15
CONCURRENCY=10
BATCH_SIZE=100

# Supabase Public Frontend Configuration (Used by Cloudflare Pages / Static Web)
# Can be configured in web/js/config.js or via the in-dashboard setup dialog
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
